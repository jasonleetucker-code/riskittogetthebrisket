[Unit]
Description=Joint robust-filter shadow ledger for __SERVICE_NAME__
After=network-online.target
Wants=network-online.target

# Batch 3 Unit F. Builds the newest production board twice through the
# deployed code -- the incumbent Hampel filter and the #1571 filter half
# (joint_outlier_sparse_challenger; the sparse half stays OFF) -- and appends
# one record to the append-only ledger data/robust_filter_shadow/ledger.jsonl
# plus a write-once observation panel, then refreshes the preregistered
# evaluation (docs/valuation/evidence/joint-filter-shadow-2026-10-01/).
#
# WHY A PROD-SIDE TIMER AND NOT CI: it reads the live export, the live source
# CSVs and the live dataset state from disk and writes into gitignored data/.
# A CI runner would record a board nobody served.
#
# SHADOW ONLY. It reads the board and writes into data/robust_filter_shadow/.
# It never writes a served value, never flips a flag and never promotes the
# challenger. Promotion is an owner decision after independent review.
#
# Idempotent: one record per (board payload, code, challenger version); a
# re-run on an unchanged board is a no-op.
#
# Exit codes (scripts/joint_filter_shadow.py):
#   0 - recorded (or already recorded) and evaluated
#   1 - soft failure (no export found, write error, nothing to evaluate yet)
#   2 - a built contract came back structurally wrong
# systemd reports 1 and 2 as unit failures so the journal shows them.

[Service]
Type=oneshot
User=__APP_USER__
Group=__APP_USER__
WorkingDirectory=__APP_DIR__
# The same .env the API reads, so every OTHER feature flag (freshness
# weighting, family cap, ...) is what production serves; the script pins only
# the two challenger flags per variant and records the full flag snapshot.
EnvironmentFile=-__APP_DIR__/.env
Environment=PYTHONUTF8=1
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=read-only
# Write scope is the checkout's data/ dir, which always exists. The ledger
# directory itself (data/robust_filter_shadow) is created on first run, so it
# must not be named here: systemd cannot bind-mount a path that does not exist
# yet (226/NAMESPACE).
ReadWritePaths=__APP_DIR__/data
ExecStart=__VENV_DIR__/bin/python __APP_DIR__/scripts/joint_filter_shadow.py record --then-evaluate
StandardOutput=journal
StandardError=journal
TimeoutStartSec=900
# Background bookkeeping -- never user-facing.
Nice=10
IOSchedulingClass=idle

[Install]
WantedBy=multi-user.target
