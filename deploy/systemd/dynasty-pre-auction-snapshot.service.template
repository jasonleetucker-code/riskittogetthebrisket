[Unit]
Description=Pre-auction rookie-draft board + roster-context snapshot (__SERVICE_NAME__)
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=4h
StartLimitBurst=4

# The pre-draft board and every team's roster context are unrecoverable once the
# first rookie pick lands (scripts/backtest_perfect_draft.py).  This records them
# automatically via scripts/capture_pre_auction_snapshot.py:
#   data/draft_backtest/<year>-pre.json          first-valid-wins, never overwritten,
#                                                only inside 7 days of a Sleeper-stated start
#   data/draft_backtest/<year>-early-<ISOweek>.json  weekly insurance copy, never overwritten
# Refuses once the Sleeper draft is drafting/complete or its start_time has passed.
# Stored box-local and gitignored (data/), like the pick-forecast and board
# snapshots; it holds private roster contexts, so it must not enter git.
#
# Exit codes: 0 recorded / already held; 5 terminal skip (draft started / start
# margin crossed -- nothing left to capture); 1 error, 3 transient (Sleeper
# unreadable), 4 no usable board (no cache, or stale/unknown-age board).
# SuccessExitStatus=0 5 keeps the terminal skip green (no retry, no failed unit);
# 1/3/4 are failures and retry via Restart=on-failure (bounded by StartLimitBurst).
# ROLLBACK: systemctl disable --now __SERVICE_NAME__-pre-auction-snapshot.timer

[Service]
Type=oneshot
User=__APP_USER__
Group=__APP_USER__
WorkingDirectory=__APP_DIR__
# Same .env the API reads: the contract is rebuilt from the on-disk cache under
# the flags production serves, and `import server` needs its login setting.
EnvironmentFile=-__APP_DIR__/.env
Environment=PYTHONUTF8=1
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=__APP_DIR__/data
ExecStart=__VENV_DIR__/bin/python __APP_DIR__/scripts/capture_pre_auction_snapshot.py
StandardOutput=journal
StandardError=journal
TimeoutStartSec=900
SuccessExitStatus=0 5
Restart=on-failure
RestartSec=20min
MemoryMax=1536M
Nice=10
IOSchedulingClass=idle

[Install]
WantedBy=multi-user.target
