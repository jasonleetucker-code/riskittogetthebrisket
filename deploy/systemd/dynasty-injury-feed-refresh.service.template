[Unit]
Description=Dynasty Trade Calculator ESPN injury-feed refresh (__SERVICE_NAME__)
After=network-online.target
Wants=network-online.target

# Part of the Live Waiver Opportunity layer
# (docs/faab-live-opportunity-model.md).  Fetches the league-wide ESPN
# injury report, diffs against the prior run
# (data/nfl_data/injuries_prior.json), and derives INJURY /
# ACTIVATED_RETURN events from a status transition (new injury, worsened
# status, or recovery).
#
# SHADOW ONLY since 2026-10-26: the derived events are written to
# data/nfl_data/injury_events_shadow.json, which nothing loads, and NEVER to
# data/bdvm/events/<season>.json (read by src/bdvm/service.py for every BDVM
# valuation and by src/trade/faab_opportunity.py).  ESPN's payload had changed
# shape (the athlete id moved into the athlete links) and the parser read zero
# entries for weeks; repairing it would otherwise have turned ~274 currently
# injured players into "new" events on the first run.  The first non-empty run
# only SEEDS the prior.  Writing these events to BDVM again is an owner decision
# (see scripts/refresh_depth_charts.py, #1926, for the same rule).
#
# WHY A PROD-SIDE TIMER AND NOT CI: same reasoning as
# dynasty-playerctx-refresh — the events file lives under gitignored
# data/, so a CI-built artifact never reaches the running server.
#
# RISKIT_FEATURE_ESPN_INJURY_FEED=1 is scoped to THIS unit's
# environment only — see dynasty-depth-charts-refresh.service.template
# for the same rollback-lever reasoning.
#
# Exit codes (scripts/refresh_injury_feed.py):
#   0 - ok (including "flag off, no-op" and "no injuries")
#   1 - fetch not proven (ESPN network failure, open breaker, an
#       unexpected payload shape, or a body whose rows the parser cannot read:
#       no events, no history row), identity step unusable (history recorded;
#       prior and shadow ledger untouched), or a shadow-ledger write failed;
#       prior snapshot untouched in every case.  A failed write of the
#       response cache (data/nfl_data_cache/, e.g. disk full) ALSO exits
#       non-zero even when ESPN answered: the cache entry is the fetch proof,
#       so without it nothing is recorded or diffed.
#
# Also appends each proven fetch to the as-known history log
# data/nfl_data/injury_history/ (src/nfl_data/injury_history.py; backed up
# by riskit-state-backup.sh).

[Service]
Type=oneshot
User=__APP_USER__
Group=__APP_USER__
WorkingDirectory=__APP_DIR__
EnvironmentFile=-__APP_DIR__/.env
Environment=RISKIT_FEATURE_ESPN_INJURY_FEED=1
ExecStart=__VENV_DIR__/bin/python __APP_DIR__/scripts/refresh_injury_feed.py
StandardOutput=journal
StandardError=journal
Nice=10
IOSchedulingClass=idle
TimeoutStartSec=120

[Install]
WantedBy=multi-user.target
