[Unit]
Description=Sleeper trending adds+drops history snapshot (__SERVICE_NAME__)
After=network-online.target
Wants=network-online.target

# Part of the Live Waiver Opportunity layer
# (docs/faab-live-opportunity-model.md).  Appends one snapshot to
# data/waiver/trending_history.json so 6h/12h/24h/48h velocity is
# computable (src/adapters/sleeper_trending_history.py).  Public
# unauthenticated Sleeper endpoint, no credentials — installs
# unconditionally.
#
# WHY A PROD-SIDE TIMER AND NOT CI: same reasoning as
# dynasty-playerctx-refresh — the history file lives under gitignored
# data/, so a CI-built artifact never reaches the running server.
#
# Exit codes (scripts/refresh_sleeper_trending_history.py):
#   0 - a snapshot was recorded
#   1 - both the adds and drops fetch failed this run

[Service]
Type=oneshot
User=__APP_USER__
Group=__APP_USER__
WorkingDirectory=__APP_DIR__
EnvironmentFile=-__APP_DIR__/.env
ExecStart=__VENV_DIR__/bin/python __APP_DIR__/scripts/refresh_sleeper_trending_history.py
StandardOutput=journal
StandardError=journal
Nice=10
IOSchedulingClass=idle
TimeoutStartSec=60

[Install]
WantedBy=multi-user.target
