[Unit]
Description=Dynasty Trade Calculator Market Trade Ledger rebuild (__SERVICE_NAME__)
After=network-online.target

# Rebuilds the DERIVED canonical underlying-trade ledger
# (data/market_trades/underlying_trades.sqlite) and its coverage report
# (data/market_trades/reports/) from the box-local raw evidence: the KTC raw
# archive (dynasty-ktc-trades), the read-only Sharp intel ledger and the
# acquisition store.  Owner: src/trade/market_trade_report.py.  Evidence for
# comps / liquidity / evaluation only — it never moves a canonical value.
#
# WHY ITS OWN DAILY UNIT (it used to be the KTC fetch's every-30-minute
# ExecStartPost):
#   * nothing reads the derived ledger on a request path or on a schedule —
#     it is a research artifact whose report is already one file per UTC day,
#     so 48 rebuilds a day produced one surviving report and 47 discarded ones;
#   * the raw archive is append-only, so a rebuild can never MISS evidence by
#     running later; only the KTC FETCH races the rolling window, and it keeps
#     its every-30-minute cadence untouched;
#   * a separate unit is a separate failure domain: a slow or memory-hungry
#     rebuild can no longer eat the fetch's TimeoutStartSec or share its
#     cgroup, and a killed rebuild cannot fail a capture.
# 08:52 UTC runs after the day's Sharp discovery (04:20), records (04:50),
# rosters (05:50) and the 08:20 transactions pass, so it sees fresh formats
# and the morning's Sleeper-lane trades.
#
# Exit codes (scripts/market_trade_ledger.py): 0 built · 1 error · 2 no
# observations in any lane.  Nothing downstream is user-facing.

[Service]
Type=oneshot
User=__APP_USER__
Group=__APP_USER__
WorkingDirectory=__APP_DIR__
# No EnvironmentFile: reads box-local files only and needs no secret.
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=__APP_DIR__/data
# --no-board skips the residual pass (run scripts/market_trade_ledger.py by
# hand for residuals against a board).
ExecStart=__VENV_DIR__/bin/python __APP_DIR__/scripts/market_trade_ledger.py --no-board
StandardOutput=journal
StandardError=journal
Nice=10
IOSchedulingClass=idle
# MEMORY — MEASURED ON THE BOX, NOT SYNTHETIC (2026-10-25).  The grouping is
# blocked (src/trade/market_trade_groups.py), but the build holds every
# observation of the append-only history in memory, so its working set grows
# with the archive every day.  A read-only probe of build_ledger() on the live
# stores (36,637 observations) peaked at 858 MiB RSS (~108 MiB of it the Sleeper
# player directory; ~20 KiB per observation on top), and the archive gains
# ~1.3k observations a day (~27 MiB/day).  The former limits (MemoryHigh=768M,
# MemoryMax=1G, sized from "~50 MB peak for 20k synthetic observations") were
# crossed at ~34k observations: from 2026-10-24 the cgroup sat above
# MemoryHigh, the kernel throttled every allocation, and the run crawled
# (71 s of CPU in 15 min; 6.7 MB of a ~250 MB ledger written) until
# TimeoutStartSec killed it -- a stall reported as a timeout.
#
# No MemoryHigh, deliberately: for a batch job a throttle converts "too big"
# into a 15-minute stall that reads as a hang (the same failure mode
# docs/ops/BACKEND_MEMORY_POLICY_2026-10-21.md measured on the backend).  The
# hard ceiling is kept, so a regression is KILLED promptly and fails loudly.
# 2G is ~1.1 GiB above today's peak, ~6 weeks of growth at the measured rate;
# the script prints its peak RSS every run so the trend is in the journal.
# This buys time and is not the cure: memory proportional to the whole history
# is the market-trades owner's to fix (stream the persist, share per-league
# format objects).
#
# A kill leaves the temp database and its -journal, which the next run removes
# before building.
MemoryMax=2G
# The ceiling sum is oversubscribed (docs/ops/BACKEND_MEMORY_POLICY_2026-10-21.md,
# 2026-10-25 addendum).  If the HOST ever runs out, the kernel OOM killer must
# take this research batch job (rebuilt tomorrow from an append-only archive),
# never the backend that serves the site.
OOMScoreAdjust=500
TimeoutStartSec=900

[Install]
WantedBy=multi-user.target
