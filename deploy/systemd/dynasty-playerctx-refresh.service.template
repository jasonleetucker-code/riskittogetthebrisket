[Unit]
Description=Dynasty Trade Calculator player-context refresh (__SERVICE_NAME__)
After=network-online.target
Wants=network-online.target

# Produces data/playerctx/snapshot.json — the contracts / snap-share /
# depth-chart context the player profile card reads through
# GET /api/playerctx/player.
#
# WHY A PROD-SIDE TIMER AND NOT CI: the endpoint reads a LOCAL file
# (src/playerctx/store.py::SNAPSHOT_PATH → __APP_DIR__/data/playerctx/
# snapshot.json) and data/ is gitignored repo-wide, so a snapshot built
# on a CI runner never reaches the VPS.  The producer has to run where
# the reader lives.  Same reasoning as the DLF/IDP-show fetch timers.
#
# The script only downloads PUBLIC nflverse release assets — no
# credentials, no tokens, so this timer installs unconditionally.
#
# Exit codes (scripts/refresh_playerctx.py):
#   0 - snapshot written
#   1 - soft failure (network / parse); last-good snapshot untouched
#   2 - schema regression or row-count collapse; last-good untouched
# systemd reports 1 and 2 as unit failures so the journal shows them;
# in both cases the previously published snapshot stays live, which is
# exactly the degrade we want (stale context beats no context).

[Service]
Type=oneshot
User=__APP_USER__
Group=__APP_USER__
WorkingDirectory=__APP_DIR__
EnvironmentFile=-__APP_DIR__/.env
# --retain-history additionally writes a dated, snaps-only projection to
# data/playerctx/history/snapshot_YYYY-MM-DD.json (~320 KB) after the
# live snapshot lands.  It is best-effort by construction: a retention
# failure never fails the refresh, because the live file the API reads
# is already written by then.  A separate unit
# (__SERVICE_NAME__-playerctx-history) is what pushes those dated files
# to main; this one only produces them locally.
ExecStart=__VENV_DIR__/bin/python __APP_DIR__/scripts/refresh_playerctx.py --retain-history
StandardOutput=journal
StandardError=journal
# A full run is ~3 min (dominated by the ~35 MB depth-chart download and
# the fuzzy-match tail); unchanged files are skipped via ETag.  Be kind
# to the box — this is background enrichment, never user-facing latency.
Nice=10
IOSchedulingClass=idle
TimeoutStartSec=900

[Install]
WantedBy=multi-user.target
