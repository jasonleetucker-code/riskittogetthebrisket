[Unit]
Description=Rookie auction room: back up, restore and verify the store for __SERVICE_NAME__
After=network-online.target

# Takes an ONLINE SQLite backup of data/auction/auction.sqlite, restores
# it into a scratch store, replays every room's command log and checks
# invariants + awards, and only then keeps the copy and records
# last_verified_backup (shown in the commissioner's preflight).
# On-host copies: they bound a process/database fault to ~1 hour; they
# do NOT survive losing the disk (see docs/auction/ROOKIE_AUCTION_ROOM.md).
#
# Exit codes (scripts/auction_backup_verify.py): 0 verified, 1 verify
# failed (copy kept as *.FAILED), 2 store unavailable. A missing store is
# a failure the journal should show, never a silent pass.

[Service]
Type=oneshot
# User=/Group= are load-bearing: a root-owned copy directory would make
# every later run fail (same lesson as the board-snapshot unit).
User=__APP_USER__
Group=__APP_USER__
WorkingDirectory=__APP_DIR__
EnvironmentFile=-__APP_DIR__/.env
ExecStart=__VENV_DIR__/bin/python __APP_DIR__/scripts/auction_backup_verify.py
StandardOutput=journal
StandardError=journal
TimeoutStartSec=600
Nice=10
IOSchedulingClass=idle

[Install]
WantedBy=multi-user.target
