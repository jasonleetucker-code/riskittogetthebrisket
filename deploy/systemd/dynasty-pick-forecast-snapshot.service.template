[Unit]
Description=Weekly point-in-time pick-forecast / team-strength snapshot for __SERVICE_NAME__
After=network-online.target
Wants=network-online.target
# Retry brake: Restart=on-failure below re-runs a failed capture every 20 min;
# at most 4 starts per 4 h, so a persistent failure stops retrying and is left
# failed in the journal until the next timer slot (Wed/Thu catch-ups).
StartLimitIntervalSec=4h
StartLimitBurst=4

# AL-P4 (Adaptive Learning directive section 10 + section 21 "capture first";
# perishable audit docs/BRISKET_IDEAS.md section 13.4). The Pick Projector is
# computed per request off the CURRENT team_ros_strength, which is overwritten
# in place, so the state a forecast was made from at week N cannot be rebuilt
# later. This records, per active league and per Sleeper NFL week, each team's
# strength / depth / injuries / roster / record / points / all-play /
# remaining schedule / roster quality / age, current pick ownership by
# canonical pick id, the forecast the Pick Projector serves with its model
# identity, and the league's playoff/draft rules -- all read from the existing
# canonical owners -- to the append-only monthly
# data/pick_forecast_snapshots/ledger-YYYY-MM.jsonl (scripts/snapshot_pick_forecast.py).
#
# CAPTURE ONLY. Nothing reads the store; nothing served changes (team strength
# is read with persist=False). Missing inputs are recorded as null WITH a
# reason, never zero. Private and box-local: the directory is gitignored and is
# NOT under data/ros/, which the scheduled refresh force-adds to git.
#
# Idempotent and append-only: per (league, season, season type, capture
# window) a run writes only when its tier beats what the window holds (settled
# > unsettled, then complete > partial > degraded); a better record is a new
# line naming what it supersedes, never an overwrite. A core field (teams +
# standings, pick ownership, forecast) missing because a read FAILED is not
# written at all -- the run exits 3 and Restart=on-failure retries it, so one
# Sleeper timeout cannot take the week.
#
# Exit codes: 0 recorded (or already held at an equal/better tier); 1 a hard
# failure (no league configured, a league failed to assemble/write); 3
# transient (Sleeper's NFL state unreadable -- no window is guessed -- or a core
# field missing for a transient reason). Both 1 and 3 are unit failures, shown
# in the journal and retried.

[Service]
Type=oneshot
User=__APP_USER__
Group=__APP_USER__
WorkingDirectory=__APP_DIR__
# The same .env the API reads, so the contract built for roster quality is
# built under the flags production serves.
EnvironmentFile=-__APP_DIR__/.env
Environment=PYTHONUTF8=1
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=read-only
# Write scope is the checkout's data/ dir, which always exists. The store
# (data/pick_forecast_snapshots) is created on first run, so it must not be
# named here: systemd cannot bind-mount a path that does not exist yet
# (226/NAMESPACE).
ReadWritePaths=__APP_DIR__/data
ExecStart=__VENV_DIR__/bin/python __APP_DIR__/scripts/snapshot_pick_forecast.py record
StandardOutput=journal
StandardError=journal
TimeoutStartSec=900
# Retried on failure (exit 1 or 3); see StartLimit* in [Unit] for the brake.
# Type=oneshot ignores systemd's default RestartSec, so it is set explicitly.
Restart=on-failure
RestartSec=20min
# Builds the canonical contract in memory from the ~4 MB served payload, plus a
# Sleeper snapshot and (only when the persisted team-strength file is stale)
# the ~5 MB player dump. A hard ceiling against a regression, not a working-set
# estimate; same posture as the other contract/ledger-building units.
MemoryMax=1536M
# Background bookkeeping -- never user-facing.
Nice=10
IOSchedulingClass=idle

[Install]
WantedBy=multi-user.target
