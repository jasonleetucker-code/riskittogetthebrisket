[Unit]
Description=Sparse-evidence estimator shadow ledger for __SERVICE_NAME__
After=network-online.target
Wants=network-online.target

# Batch 3 Unit E. Builds the newest served board twice through the deployed
# code -- the incumbent (flag sparse_evidence_estimator OFF: the 0.30
# single-source retention, what production serves) and candidate C (flag ON:
# censor-aware family bounds) -- and appends one line per board to the
# append-only monthly ledger data/sparse_evidence_shadow/ledger-YYYY-MM.jsonl
# (idempotency from the ledger.keys index): payload hash, payload age,
# code revision, each scoped row's evidenceState, C's estimate / interval /
# bounds and the incumbent value. Evidence for a future re-preregistered
# candidate (docs/valuation/evidence/sparse-evidence-2026-10-01/README.md).
#
# WHY A PROD-SIDE TIMER AND NOT CI: it reads the live export, the live source
# CSVs and the live dataset state from disk and writes into gitignored data/.
# A CI runner would record a board nobody served.
#
# SHADOW ONLY. It never writes a served value, never flips a flag and never
# promotes the challenger (tests/api/test_sparse_evidence_shadow.py). The
# challenger did not meet its preregistered gate (G2c) and stays OFF.
#
# Idempotent: one line per (payload, code revision, inputs, estimator
# version); a re-run on an unchanged board is a no-op.
#
# Exit codes (scripts/sparse_evidence_shadow.py):
#   0 - recorded (or already recorded)
#   1 - soft failure (no payload found, write error)
#   2 - a built contract came back structurally wrong
#   3 - the freshest payload (by its own scrapeTimestamp) is older than the
#       6 h scrape-cadence budget, or states no scrape time: the feed may have
#       stopped, so nothing is recorded rather than "already recorded"
# systemd reports 1, 2 and 3 as unit failures so the journal shows them.

[Service]
Type=oneshot
User=__APP_USER__
Group=__APP_USER__
WorkingDirectory=__APP_DIR__
# The same .env the API reads, so every OTHER feature flag is what production
# serves; the script pins only sparse_evidence_estimator per build and records
# the full flag snapshot.
EnvironmentFile=-__APP_DIR__/.env
Environment=PYTHONUTF8=1
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=read-only
# Write scope is the checkout's data/ dir, which always exists. The ledger
# directory itself (data/sparse_evidence_shadow) is created on first run, so it
# must not be named here: systemd cannot bind-mount a path that does not exist
# yet (226/NAMESPACE).
ReadWritePaths=__APP_DIR__/data
ExecStart=__VENV_DIR__/bin/python __APP_DIR__/scripts/sparse_evidence_shadow.py record
StandardOutput=journal
StandardError=journal
TimeoutStartSec=600
# Background bookkeeping -- never user-facing.
Nice=10
IOSchedulingClass=idle

[Install]
WantedBy=multi-user.target
