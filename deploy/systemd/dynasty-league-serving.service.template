[Unit]
Description=Prepared league rankings and trade views (__SERVICE_NAME__)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=__PRODUCER_USER__
Group=__PRODUCER_GROUP__
SupplementaryGroups=__SERVING_READER_GROUP__
WorkingDirectory=__APP_DIR__
EnvironmentFile=__PRODUCER_ENV_FILE__
Environment=PYTHONUNBUFFERED=1
ExecStart=/usr/bin/env RISKIT_SERVING_DIR=__SERVING_DIR__ RISKIT_SERVING_READER_GID=__SERVING_READER_GID__ RISKIT_SERVING_ATTESTATION_PRIVATE_KEY=__SIGNING_KEY_FILE__ RISKIT_SERVING_ATTESTATION_PUBLIC_KEY=__PUBLIC_PIN_FILE__ __VENV_DIR__/bin/python __APP_DIR__/scripts/refresh_league_serving.py
SuccessExitStatus=3
TimeoutStartSec=1200
TimeoutStopSec=30
KillMode=control-group
Nice=10
IOSchedulingClass=idle
UMask=0077
StandardOutput=journal
StandardError=journal
