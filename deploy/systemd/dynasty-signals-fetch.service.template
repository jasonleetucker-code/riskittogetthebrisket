[Unit]
Description=Dynasty Trade Calculator Signals Fantasy public-board collection (__SERVICE_NAME__)
After=network-online.target
Wants=network-online.target

# Collects Signals Fantasy's two PUBLIC dynasty boards (/rankings/dynasty,
# /rankings/idp-dynasty) into data/sources/signals/ — a box-local private
# store read by GET /api/second-opinion/signals (authenticated only).
# Owner: src/sources/signals.py.  Authorization: owner attestation
# 2026-10-01; public boards only, read-only, no login, no paid surface.
#
# WHY A PROD-SIDE TIMER AND NOT CI: GitHub Actions output is public, and
# raw Signals pages/data must never be committed.  data/ is gitignored and
# no workflow or push script force-adds data/sources/, so the store never
# leaves the box.  Same reasoning as the crowd-FAAB and BDVM timers.
#
# Politeness is enforced by the script, not just the schedule: one GET per
# board per run, conditional (If-None-Match / If-Modified-Since) once a good
# release exists, Retry-After honoured on 429, and a 401/403 PERSISTS a stop
# that later runs obey until an operator runs --clear-stop.
#
# Exit codes (scripts/fetch_signals.py):
#   0 - every board ok (published / unchanged / 304 / skipped)
#   1 - a board failed or is stopped
#   2 - a board was quarantined for schema drift
# On 1/2 the last good release stays live with its true age.

[Service]
Type=oneshot
User=__APP_USER__
Group=__APP_USER__
WorkingDirectory=__APP_DIR__
EnvironmentFile=-__APP_DIR__/.env
ExecStart=__VENV_DIR__/bin/python __APP_DIR__/scripts/fetch_signals.py --min-interval-hours 5
StandardOutput=journal
StandardError=journal
Nice=10
IOSchedulingClass=idle
TimeoutStartSec=600

[Install]
WantedBy=multi-user.target
