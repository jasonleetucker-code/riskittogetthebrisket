[Unit]
Description=Dynasty Trade Calculator ESPN depth-chart refresh (__SERVICE_NAME__)
After=network-online.target
Wants=network-online.target

# Part of the Live Waiver Opportunity layer
# (docs/faab-live-opportunity-model.md).  Fetches all 32 NFL teams'
# ESPN depth charts, diffs against the prior run
# (data/nfl_data/depth_charts_prior.json), and turns a scored slot
# change into a DEPTH_CHART_PROMOTION/DEMOTION event.
#
# SHADOW ONLY (2026-10-25): derived events go to
# data/nfl_data/depth_chart_events_shadow.json, which nothing loads.
# They are NOT merged into data/bdvm/events/<season>.json — that file
# feeds every BDVM valuation, and the merge had never run (the ESPN path
# returned {} until this date).  Activating it needs measured event
# volume / false positives and owner approval.
#
# WHY A PROD-SIDE TIMER AND NOT CI: same reasoning as
# dynasty-playerctx-refresh — the events file lives under gitignored
# data/, so a CI-built artifact never reaches the running server.
#
# RISKIT_FEATURE_DEPTH_CHART_VALIDATION=1 is scoped to THIS unit's
# environment only (the documented rollback-lever pattern in
# src/api/feature_flags.py) — the global default stays False because
# the gate is SCRIPT_ONLY, not LIVE: toggling it globally would change
# no request/response, only what this one script fetches.
#
# Exit codes (scripts/refresh_depth_charts.py):
#   0 - all 32 teams fetched (or flag off -> no-op)
#   1 - more than 5 teams failed this run; a failed team keeps its last
#       good chart in the prior snapshot

[Service]
Type=oneshot
User=__APP_USER__
Group=__APP_USER__
WorkingDirectory=__APP_DIR__
EnvironmentFile=-__APP_DIR__/.env
Environment=RISKIT_FEATURE_DEPTH_CHART_VALIDATION=1
ExecStart=__VENV_DIR__/bin/python __APP_DIR__/scripts/refresh_depth_charts.py --force
StandardOutput=journal
StandardError=journal
Nice=10
IOSchedulingClass=idle
TimeoutStartSec=300

[Install]
WantedBy=multi-user.target
