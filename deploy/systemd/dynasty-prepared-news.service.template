[Unit]
Description=Dynasty prepared news producer (__SERVICE_NAME__)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=__PRODUCER_USER__
Group=__PRODUCER_GROUP__
SupplementaryGroups=__SERVING_READER_GROUP__
WorkingDirectory=__APP_DIR__
EnvironmentFile=__PRODUCER_ENV_FILE__
# Keep provider instances alive: ESPN rotates target attempts and Sleeper caches
# its directory for 24 hours. One-shot timers would reset both on every refresh.
ExecStart=/usr/bin/env RISKIT_SERVING_DIR=__SERVING_DIR__ RISKIT_SERVING_READER_GID=__SERVING_READER_GID__ RISKIT_SERVING_ATTESTATION_PRIVATE_KEY=__SIGNING_KEY_FILE__ RISKIT_SERVING_ATTESTATION_PUBLIC_KEY=__PUBLIC_PIN_FILE__ __VENV_DIR__/bin/python __APP_DIR__/scripts/refresh_prepared_news.py --watch
Restart=on-failure
RestartSec=15
UMask=0077
StandardOutput=journal
StandardError=journal
Nice=10
IOSchedulingClass=idle
TimeoutStopSec=90

[Install]
WantedBy=multi-user.target
