[Unit]
Description=Dynasty prepared news producer (__SERVICE_NAME__)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=__APP_USER__
Group=__APP_USER__
WorkingDirectory=__APP_DIR__
EnvironmentFile=-__APP_DIR__/.env
# Keep provider instances alive: ESPN rotates target attempts and Sleeper caches
# its directory for 24 hours. One-shot timers would reset both on every refresh.
ExecStart=__VENV_DIR__/bin/python __APP_DIR__/scripts/refresh_prepared_news.py --watch
Restart=on-failure
RestartSec=15
UMask=0077
StandardOutput=journal
StandardError=journal
Nice=10
IOSchedulingClass=idle
TimeoutStopSec=90

[Install]
WantedBy=multi-user.target
