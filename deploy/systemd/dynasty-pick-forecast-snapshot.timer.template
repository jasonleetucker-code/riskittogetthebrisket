[Unit]
Description=Weekly pick-forecast / team-strength snapshot (Tuesday 12:20 UTC) for __SERVICE_NAME__
# No Requires= on the service: [Timer] Unit= already binds it, and a
# Requires= here would start the service on every boot and let a service
# failure stop the timer. Persistent=true is the catch-up.

[Timer]
# Tuesday, after Monday night's games have settled and clear of the other
# Tuesday jobs (playerctx 05:40, bdvm 06:10). One cadence on purpose: the
# record is first-write-wins per Sleeper NFL week, so a second weekly slot
# would make WHEN in the week a snapshot was taken vary from week to week.
OnCalendar=Tue *-*-* 12:20:00 UTC
RandomizedDelaySec=300
Persistent=true
AccuracySec=1min
Unit=__SERVICE_NAME__-pick-forecast-snapshot.service

[Install]
WantedBy=timers.target
