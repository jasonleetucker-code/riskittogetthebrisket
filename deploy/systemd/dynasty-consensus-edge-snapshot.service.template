[Unit]
Description=Consensus Edge board snapshot for __SERVICE_NAME__
After=network-online.target
Wants=network-online.target

# WHY A PROD-SIDE TIMER AND NOT CI: it reads the live contract from disk
# and writes into gitignored data/. A CI runner has neither, so a
# snapshot built there would record a board nobody served.
#
# Two jobs per invocation — write today's board, then label the forward
# returns of snapshots whose horizon has now elapsed. The labelling
# reads its prices back out of the store's own market_value column, so
# it needs no network and no git history.
#
# Safe to install while consensus_edge is OFF (its current default):
# accumulating history is the prerequisite for ever validating the
# board, and writing it touches no existing route or data.
#
# Exit codes (scripts/snapshot_consensus_edge.py):
#   0 - snapshot written
#   1 - soft failure (no contract, no board, write error)
#   2 - schema regression: the board came back structurally wrong
# systemd reports 1 and 2 as unit failures so the journal shows them. A
# box that never has a contract has a bigger problem than this timer.

[Service]
Type=oneshot
# User=/Group= are load-bearing here, not boilerplate. This template was
# the only one in the repo without them, so the unit ran as root and
# created a root-owned data/consensus_edge.sqlite (plus its -wal and
# -shm). snapshot.connect() opens read-write, so the API process —
# running as __APP_USER__ — could then never open the database it is
# meant to read. Every snapshot would be written and none readable.
User=__APP_USER__
Group=__APP_USER__
WorkingDirectory=__APP_DIR__
EnvironmentFile=-__APP_DIR__/.env
ExecStart=__VENV_DIR__/bin/python __APP_DIR__/scripts/snapshot_consensus_edge.py
StandardOutput=journal
StandardError=journal
TimeoutStartSec=900
# Background bookkeeping — never user-facing.
Nice=10
IOSchedulingClass=idle

[Install]
WantedBy=multi-user.target
