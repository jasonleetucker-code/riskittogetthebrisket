[Unit]
Description=Nightly Risk It state backup trigger
# No Requires= on the service: a timer already triggers the unit of the
# same name, and a [Unit] Requires= also STARTS the service whenever the
# timer is started — so every `systemctl enable --now` / `start` of this
# timer (an installer refresh mid-deploy, a boot) ran the job immediately,
# off schedule.  Measured: the 2026-08-15 state-backup install ran an
# unscheduled backup.  Same convention as every dynasty-*.timer template.

[Timer]
# 02:30 UTC daily — offset from riskit-backup.timer (02:00) so the two
# backup jobs never contend for I/O.  Persistent=true replays a run
# missed while the box was down.
OnCalendar=*-*-* 02:30:00 UTC
Persistent=true
AccuracySec=5min

[Install]
WantedBy=timers.target
