{
  "permissions": {
    "allow": [
      "Bash(git grep *)",
      "Bash(git merge-base *)",
      "Bash(git ls-tree *)",
      "Bash(gh run watch *)",
      "Bash(bash -n *)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/health-check.sh"
          }
        ]
      }
    ]
  }
}
