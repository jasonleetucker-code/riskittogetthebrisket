 EnvironmentFile=-__APP_DIR__/.env
 
 # ── Resource sanity ─────────────────────────────────────────────────
-# Assumes a >=4 GB production VPS (see docs/PROD-HARDENING.md; verify
-# with `free -m` before applying).  Steady-state RSS is dominated by
-# the in-memory contract + payload views; Playwright scrape cycles
-# spike it.  MemoryHigh throttles/reclaims first; MemoryMax is the
-# hard OOM line, after which Restart=always brings the service back.
-# Comment both out on a smaller box rather than guessing lower.
-MemoryHigh=2560M
-MemoryMax=3G
+# Host (MEASURED, restart diagnostics 2026-10-19 / 2026-10-21): 7941 MiB
+# RAM, 4 vCPU, NO swap.  Steady-state RSS is dominated by the in-memory
+# contract + payload views; Playwright scrape cycles add ~720 MiB of
+# Chromium (6 processes) INSIDE this cgroup.
+#
+# MemoryHigh is deliberately NOT set.  memory.high is a THROTTLE, not a
+# warning level, and on a swapless host this cgroup's memory is ~99.6%
+# anonymous, which cannot be reclaimed -- so at the line the kernel
+# evicts every file page (the interpreter's own) and sleeps the
+# allocating threads instead of freeing anything.  2026-10-21 07:50Z:
+# memory.events high rose 63,734 -> 127,174 in two minutes while
+# max=0 and oom_kill=0; the service answered nothing for ~3 minutes until
+# the watchdog restarted it, ~4.5 minutes until it served again.  A
+# replacement process then regrew to 2.39 GiB within ~30 minutes, so
+# 3584M is a canary value, not a proven fit.  MemoryMax is a hard line: past it the
+# kernel kills the process in seconds and Restart=always brings it back
+# (a ~30 s outage instead of a multi-minute stall).
+# Full record and rollback: docs/ops/BACKEND_MEMORY_POLICY_2026-10-21.md.
+MemoryMax=3584M
 
