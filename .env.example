# Environment variables for the dynasty trade-calculator stack.

# FRONTEND_URL was removed in #555 along with the backend's page proxy.
# Traffic goes one way now: Next calls the backend (BACKEND_API_URL), and
# nginx routes pages to Next without the backend involved. Setting
# FRONTEND_URL has no effect.

# Canonical Sleeper league IDs.
#
# League configuration now lives in config/leagues/registry.json,
# which is the authoritative source once present.  The env vars
# below are the single-league back-compat fallback — when the
# registry file is missing (fresh dev checkout, CI without config),
# code reads SLEEPER_LEAGUE_ID from here to synthesise a one-league
# registry.  Once a registry.json exists, these env vars are
# ignored for league-ID resolution.  See config/leagues/README.md
# for how to add leagues.
#
# Point the code at a non-default registry file with:
#   LEAGUE_REGISTRY_PATH=/absolute/path/to/your/registry.json
#
# Values below are PLACEHOLDERS — replace with your own IDs.  A
# Sleeper league ID is the 18-19 digit number in the league URL:
#   https://sleeper.com/leagues/<SLEEPER_LEAGUE_ID>/team
SLEEPER_LEAGUE_ID=000000000000000000

# ── Scraper credentials ──────────────────────────────────────────────────
# DraftSharks login (for scripts/fetch_draftsharks.py auto-refresh)
# DRAFTSHARKS_EMAIL=
# DRAFTSHARKS_PASSWORD=
#
# DLF / DynastyLeagueFootball login (for scripts/fetch_dlf.py auto-refresh
# of the four boards: dlfSf, dlfIdp, dlfRookieSf, dlfRookieIdp).
# The scraper uses curl_cffi with Chrome TLS fingerprint impersonation
# to pass Cloudflare's JS challenge, then POSTs to wp-login.php.
# DLF_USERNAME=
# DLF_PASSWORD=

# Sleeper league trade-history rolling window (days).
# Default is 365 (one full rolling year).
SLEEPER_TRADE_HISTORY_DAYS=365

# Private-use app login gate.  Both values are PLACEHOLDERS —
# replace them before running anything you care about.
#
# If you change the username, set PRIVATE_APP_ALLOWED_USERNAMES to
# the same value (comma-separated for several operators) — it gates
# the /api/admin/* endpoints and has its own separate default.
JASON_LOGIN_USERNAME=your-username
# PRIVATE_APP_ALLOWED_USERNAMES=your-username
# REQUIRED: server will not start without this set
JASON_LOGIN_PASSWORD=changeme
# Set to false only for local HTTP dev (defaults to true for production safety)
JASON_AUTH_COOKIE_SECURE=true

# R-10: Minimum free disk space (MB) before skipping data file writes
DISK_SPACE_MIN_MB=500

# R-8: Log format — "text" for human-readable (default), "json" for structured log aggregation
LOG_FORMAT=text

# Uptime watchdog configuration
# UPTIME_CHECK_ENABLED=true
# UPTIME_CHECK_URL=https://chaseupside.com/api/health
# UPTIME_CHECK_INTERVAL_SEC=300
# UPTIME_CHECK_TIMEOUT_SEC=5
# UPTIME_ALERT_FAIL_THRESHOLD=2


# Email alerting (all required for alerts to work)
# ALERT_ENABLED=true
# ALERT_TO=you@example.com
# ALERT_FROM=sender@gmail.com
# ALERT_PASSWORD=gmail-app-password

# Web Push (PWA notifications) — set ALL THREE to enable browser
# push.  Generate a fresh keypair with:
#
#     python -c "from py_vapid import Vapid; v=Vapid(); v.generate_keys(); \
#       import base64; print('PRIV:', base64.urlsafe_b64encode(\
#       v.private_key.private_numbers().private_value.to_bytes(32,'big')\
#       ).decode().rstrip('=')); from cryptography.hazmat.primitives import \
#       serialization; print('PUB:', base64.urlsafe_b64encode(\
#       v.public_key.public_bytes(serialization.Encoding.X962,\
#       serialization.PublicFormat.UncompressedPoint)).decode().rstrip('='))"
#
# VAPID_CONTACT must be a real mailto: — push providers send delivery
# failures here.
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_CONTACT=mailto:ops@example.com

# ── Sharp Tracker intel cron (Phase 5) ───────────────────────────────────
# Shared secret for the daily intel-refresh GitHub Actions workflow
# (.github/workflows/intel-refresh.yml).  The workflow POSTs
# /api/intel/refresh?leagueKey=all with ``Authorization: Bearer <token>``;
# the server accepts it when the value matches INTEL_REFRESH_TOKEN
# (falling back to SIGNAL_ALERT_CRON_TOKEN when unset).  Generate with
# ``openssl rand -hex 32`` and store the SAME value as the repo's
# INTEL_REFRESH_TOKEN Actions secret.
#
# systemd loads this file via the dynasty unit's EnvironmentFile —
# the line must be plain KEY=value (no ``export``), and the service
# must restart after edits (the token is read at process start).
# INTEL_REFRESH_TOKEN=

# Shared secret for the "Verify Sharp Production Population" smoke
# workflow (.github/workflows/verify-sharp-production.yml). It GETs
# /api/sharp/cohort and /api/sharp/market with
# ``Authorization: Bearer <token>``; the server accepts it when the
# value matches SHARP_SMOKE_TOKEN (src/sharp/service.py). Unlike
# INTEL_REFRESH_TOKEN there is no fallback token — an unset value
# leaves both endpoints session-only, exactly their behavior before
# this token existed, and the smoke workflow reports
# unverifiable_unauthenticated (loud, non-fatal) instead of measuring.
# Generate with ``openssl rand -hex 32`` and store the SAME value as
# the repo's SHARP_SMOKE_TOKEN Actions secret. Same EnvironmentFile /
# restart-after-edit rules as INTEL_REFRESH_TOKEN above.
# SHARP_SMOKE_TOKEN=

# ── Feature flags ────────────────────────────────────────────────────
#
# Every flag in src/api/feature_flags.py takes an env override named
# RISKIT_FEATURE_<FLAG_NAME_UPPERCASED>.  Reads are cached per process,
# so a change needs a SERVER RESTART — there is no runtime toggle and
# no admin endpoint that flips flags.  Current state is readable at
# GET /api/status → featureFlags (with gateStatus alongside enabled,
# because a flag can be on and still gate nothing reachable).
#
# Accepted values:
#   enable:  "1" / "true" / "yes" / "on"
#   disable: "0" / "false" / "no" / "off"
# Anything else is treated as unset and the in-code default wins.
#
# BDVM — the projection-driven fundamental valuation engine behind
# /api/bdvm/* and the /bdvm page.  Defaults ON.  Set this to 0 to roll
# back; the engine never writes rankDerivedValue, so disabling it only
# removes the /bdvm surface and the rankings "Fund gap" column.
#
# It needs a projection snapshot under data/bdvm/projections/<season>/
# or every endpoint answers status="no_projection_snapshot" with empty
# lists.  The weekly dynasty-bdvm-refresh timer builds one; to build
# by hand: python3 scripts/refresh_bdvm_projections.py
#
# RISKIT_FEATURE_BDVM_ENGINE=0
