# Python
__pycache__/
*.py[cod]
.pytest_cache/
.scrape_cache/
# Local virtualenv created by scripts/setup.sh / make setup.
.venv/
venv/
# Optional reproducible lockfile written by ``make freeze``.
requirements.lock.txt

# Node / Next
node_modules/
frontend/node_modules/
.next/
.next.new/
.next.old/
frontend/.next/
frontend/.next.new/
frontend/.next.old/
# Verification builds (NEXT_DIST_DIR=...) — hundreds of MB, never committed.
.next.*/
frontend/.next.*/
tests/e2e/playwright-report/
tests/e2e/test-results/
tests/e2e/tests/
test-results/

# Local tooling
.codex-loop/
.claude/

# Deploy state (when using local default path inside repo)
.deploy/

# Secrets / sessions / operator credentials
*_session.json
*.env
.env*
!.env.example
.secrets/

# Generated scraper outputs
dynasty_data.js
dynasty_data_*.json
CSVs/dynasty_full.csv
CSVs/dynasty_values.csv
data/
# exports/ — generated scrape outputs ignored, narrative articles
# checked in.  Use a child-glob form (not "exports/") so git still
# descends into subdirs and the !exports/narratives/ negation can
# rescue the article tree.  The weekly-narratives cron runs
# ``git add exports/narratives/`` so new articles auto-commit; league
# members reading historical articles need them durable across deploys.
exports/*
!exports/narratives/
# ROS pipeline keeps the directory tree + manual mapping overrides
# in source control so a fresh checkout has the layout in place.
# Generated scrape outputs (CSVs, run JSONs, aggregate snapshots,
# sims, team-strength) stay gitignored under data/.
!data/ros/
data/ros/sources/*
!data/ros/sources/.gitkeep
data/ros/runs/*
!data/ros/runs/.gitkeep
data/ros/aggregate/*
!data/ros/aggregate/.gitkeep
data/ros/team_strength/*
!data/ros/team_strength/.gitkeep
data/ros/sims/*
!data/ros/sims/.gitkeep
!data/ros/mapping_overrides.json

# Temporary sync artifacts (created by sync.bat or manual operations)
tmp_sync_*/

# Optional local artifacts
*.log
*.tmp
.DS_Store
Thumbs.db
*.xlsx
!CSVs/Draft Data.xlsx
# The curated-sharps research workbook is the SOURCE OF TRUTH for
# config/sharp/curated_universe.json. Tracking it is what makes the import
# reproducible -- the snapshot stamps this file's sha256, so an untracked
# workbook would leave a derived artifact nobody could regenerate or audit.
!config/sharp/workbooks/*.xlsx

# One-off research captures — never tracked (a 19MB HAR + 13MB PDF sat
# in the pack for months; see #527). Keep local copies out of commits.
*.har
CSVs/*.pdf

# E2E: empty browsers dir the Playwright config points the backend at so
# its startup scrape fails fast instead of hitting live ranking sites.
tests/e2e/.no-browsers/
