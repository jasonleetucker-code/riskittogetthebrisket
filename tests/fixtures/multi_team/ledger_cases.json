{
  "_comment": "N-team ledger validation cases (spec docs/trade/NTEAM_TRADE_ENGINE_SPEC.md §2.3), run against the LABELLED synthetic 4-team league of tests/trade/multi_team_support.py. Producer: Lane A. 'mutate' edits the league before the snapshot: stale (restored rosters), unknown (no roster stamp), multi_holder (player 101 also on team 2), pick_unpublished (team 3's pick inventory unavailable). 'policy' overrides LedgerPolicy fields. expect.ok cases list the unverifiable ids; every error case lists status / error / reason and the echoed ids.",
  "version": "trade_ledger_v1",
  "cases": [
    {"name": "valid_two_team", "teams": [1, 2], "legs": [["p:101", 1, 2], ["p:201", 2, 1]], "expect": {"ok": true, "unverifiable": []}},
    {"name": "valid_three_team_cycle", "teams": [3, 1, 2], "legs": [["p:101", 1, 2], ["p:201", 2, 3], ["p:301", 3, 1]], "expect": {"ok": true, "unverifiable": []}},
    {"name": "valid_one_to_many", "teams": [1, 2, 3], "legs": [["p:101", 1, 2], ["p:102", 1, 3], ["p:201", 2, 1], ["p:301", 3, 1]], "expect": {"ok": true, "unverifiable": []}},
    {"name": "valid_many_to_one_gift_private", "teams": [1, 2, 3], "legs": [["p:201", 2, 1], ["p:301", 3, 1]], "expect": {"ok": true, "unverifiable": []}},
    {"name": "valid_four_team_picks_only", "teams": [1, 2, 3, 4], "legs": [["pick:synth:2027:r1:o1", 1, 2], ["pick:synth:2027:r1:o2", 2, 3], ["pick:synth:2027:r1:o3", 3, 4], ["pick:synth:2027:r1:o4", 4, 1]], "expect": {"ok": true, "unverifiable": []}},
    {"name": "too_few_teams", "teams": [1], "legs": [["p:101", 1, 2]], "expect": {"status": 400, "error": "invalid_trade", "reason": "too_few_teams", "rosterIds": [1]}},
    {"name": "too_few_distinct_teams", "teams": [3, 3, 3, 3, 3], "legs": [["p:301", 3, 3]], "expect": {"status": 400, "error": "invalid_trade", "reason": "too_few_teams", "rosterIds": [3]}},
    {"name": "duplicate_team_before_too_many", "teams": [1, 1, 2, 3, 4, 5], "legs": [["p:101", 1, 2]], "expect": {"status": 400, "error": "invalid_trade", "reason": "duplicate_team", "rosterIds": [1]}},
    {"name": "too_many_teams_league_cap", "teams": [1, 2, 3, 4, 5], "legs": [["p:101", 1, 2]], "expect": {"status": 400, "error": "invalid_trade", "reason": "too_many_teams", "rosterIds": [1, 2, 3, 4, 5]}},
    {"name": "too_many_teams_policy_cap", "policy": {"max_teams": 3}, "teams": [1, 2, 3, 4], "legs": [["p:101", 1, 2]], "expect": {"status": 400, "error": "invalid_trade", "reason": "too_many_teams", "rosterIds": [1, 2, 3, 4]}},
    {"name": "team_not_in_league", "teams": [1, 9], "legs": [["p:101", 1, 9]], "expect": {"status": 400, "error": "invalid_trade", "reason": "team_not_in_league", "rosterIds": [9]}},
    {"name": "empty_trade", "teams": [1, 2], "legs": [], "expect": {"status": 400, "error": "invalid_trade", "reason": "empty_trade"}},
    {"name": "too_many_assets_before_identity", "policy": {"max_legs": 2}, "teams": [1, 2], "legs": [["junk", 1, 2], ["p:101", 1, 2], ["p:201", 2, 1]], "expect": {"status": 400, "error": "invalid_trade", "reason": "too_many_assets"}},
    {"name": "unknown_asset_forms", "teams": [1, 2], "legs": [["A Six", 1, 2], ["p:777", 1, 2], ["pick:other:2027:r1:o1", 1, 2], ["pick:synth:2027:r3:o1", 1, 2], ["p:201", 2, 1]], "expect": {"status": 400, "error": "invalid_trade", "reason": "unknown_asset", "assetIds": ["p:777", "pick:other:2027:r1:o1", "pick:synth:2027:r3:o1"]}},
    {"name": "unknown_before_duplicate", "teams": [1, 2], "legs": [["p:777", 1, 2], ["p:101", 1, 2], ["p:101", 1, 2]], "expect": {"status": 400, "error": "invalid_trade", "reason": "unknown_asset", "assetIds": ["p:777"]}},
    {"name": "duplicate_transfer", "teams": [1, 2, 3], "legs": [["p:101", 1, 2], ["p:101", 1, 3], ["p:201", 2, 1]], "expect": {"status": 400, "error": "invalid_trade", "reason": "duplicate_asset", "assetIds": ["p:101"]}},
    {"name": "invalid_origin", "teams": [1, 2], "legs": [["p:301", 3, 1], ["p:101", 1, 2]], "expect": {"status": 400, "error": "invalid_trade", "reason": "invalid_origin", "assetIds": ["p:301"]}},
    {"name": "invalid_destination", "teams": [1, 2], "legs": [["p:101", 1, 4], ["p:201", 2, 1]], "expect": {"status": 400, "error": "invalid_trade", "reason": "invalid_destination", "assetIds": ["p:101"]}},
    {"name": "destination_is_origin", "teams": [1, 2], "legs": [["p:101", 1, 1], ["p:201", 2, 1]], "expect": {"status": 400, "error": "invalid_trade", "reason": "destination_is_origin", "assetIds": ["p:101"]}},
    {"name": "non_participating_team", "teams": [1, 2, 3], "legs": [["p:101", 1, 2], ["p:201", 2, 1]], "expect": {"status": 400, "error": "invalid_trade", "reason": "idle_team", "rosterIds": [3]}},
    {"name": "one_sided_under_public_rule", "policy": {"participation": "send_and_receive"}, "teams": [1, 2, 3], "legs": [["p:201", 2, 1], ["p:301", 3, 1], ["p:101", 1, 2]], "expect": {"status": 400, "error": "invalid_trade", "reason": "one_sided_trade", "rosterIds": [3]}},
    {"name": "gift_under_public_rule", "policy": {"participation": "send_and_receive"}, "teams": [1, 2], "legs": [["p:101", 1, 2]], "expect": {"status": 400, "error": "invalid_trade", "reason": "one_sided_trade", "rosterIds": [1, 2]}},
    {"name": "asset_not_owned", "teams": [1, 2], "legs": [["p:201", 1, 2], ["p:101", 1, 2]], "expect": {"status": 409, "error": "stale_assets", "reason": "asset_not_owned", "assetIds": ["p:201"]}},
    {"name": "pick_not_owned", "teams": [1, 2], "legs": [["pick:synth:2027:r1:o2", 1, 2], ["p:201", 2, 1]], "expect": {"status": 409, "error": "stale_assets", "reason": "asset_not_owned", "assetIds": ["pick:synth:2027:r1:o2"]}},
    {"name": "free_agent_is_held_by_nobody", "teams": [1, 2], "legs": [["p:999", 1, 2], ["p:201", 2, 1]], "expect": {"status": 409, "error": "stale_assets", "reason": "asset_not_owned", "assetIds": ["p:999"]}},
    {"name": "stale_rosters_all_unverifiable", "mutate": "stale", "teams": [1, 2], "legs": [["p:101", 1, 2], ["p:201", 2, 1]], "expect": {"ok": true, "unverifiable": ["p:101", "p:201"]}},
    {"name": "stale_rosters_skip_ownership_check", "mutate": "stale", "teams": [1, 2], "legs": [["p:201", 1, 2], ["p:101", 2, 1]], "expect": {"ok": true, "unverifiable": ["p:101", "p:201"]}},
    {"name": "unknown_rosters_all_unverifiable", "mutate": "unknown", "teams": [1, 2], "legs": [["p:101", 1, 2], ["p:201", 2, 1]], "expect": {"ok": true, "unverifiable": ["p:101", "p:201"]}},
    {"name": "multi_holder_including_origin", "mutate": "multi_holder", "teams": [1, 2], "legs": [["p:101", 1, 2], ["p:201", 2, 1]], "expect": {"ok": true, "unverifiable": ["p:101"]}},
    {"name": "multi_holder_excluding_origin", "mutate": "multi_holder", "teams": [3, 2], "legs": [["p:101", 3, 2], ["p:201", 2, 3]], "expect": {"status": 409, "error": "stale_assets", "reason": "asset_not_owned", "assetIds": ["p:101"]}},
    {"name": "pick_ownership_unknown", "mutate": "pick_unpublished", "teams": [3, 1], "legs": [["pick:synth:2027:r1:o3", 3, 1], ["p:101", 1, 3]], "expect": {"ok": true, "unverifiable": ["pick:synth:2027:r1:o3"]}}
  ]
}
