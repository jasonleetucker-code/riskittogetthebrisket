+"use client";
+
+import { useSyncExternalStore } from "react";
+
+// Match the existing DataTable CSS owner exactly (app/ds.css + tokens.css).
+// Keep th/td/col geometry intact; only hidden body-cell children are deferred.
+export const COLUMN_MEDIA = { sm: "(width < 480px)", md: "(width < 768px)", lg: "(width < 1024px)" };
+const keys = Object.keys(COLUMN_MEDIA);
+const serverSnapshot = () => 0;
+const noSubscribe = () => () => {};
+function snapshot() {
+  if (typeof window === "undefined" || !window.matchMedia) return 0;
+  return keys.reduce((mask, key, index) => mask | (window.matchMedia(COLUMN_MEDIA[key]).matches ? 1 << index : 0), 0);
+}
+function subscribe(changed) {
+  if (!window.matchMedia) return () => {};
+  const queries = keys.map((key) => window.matchMedia(COLUMN_MEDIA[key]));
+  for (const query of queries) query.addEventListener("change", changed);
+  return () => { for (const query of queries) query.removeEventListener("change", changed); };
+}
+export function useHiddenColumnMask(enabled) {
+  // The server and hydration pass render the same children. The real snapshot
+  // is available before a post-hydration contract can publish cached rows.
+  return useSyncExternalStore(enabled ? subscribe : noSubscribe, enabled ? snapshot : serverSnapshot, serverSnapshot);
+}
+export function isColumnHidden(mask, hideBelow) {
+  const index = keys.indexOf(hideBelow);
+  return index >= 0 && Boolean(mask & (1 << index));
+}
