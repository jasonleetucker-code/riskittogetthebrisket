+import { expect, it } from "vitest";
+import fs from "node:fs";
+import path from "node:path";
+
+it("keeps media subscriptions identical to the existing DataTable CSS and token breakpoints", () => {
+  const helper = fs.readFileSync(path.resolve("components/ds/useHiddenColumnMask.js"), "utf8");
+  const css = fs.readFileSync(path.resolve("app/ds.css"), "utf8");
+  const tokens = fs.readFileSync(path.resolve("app/tokens.css"), "utf8");
+  for (const [key, width] of Object.entries({ sm: 480, md: 768, lg: 1024 })) {
+    expect(helper).toContain(`${key}: "(width < ${width}px)"`);
+    expect(css).toMatch(new RegExp(`@media \\(width < ${width}px\\)\\s*\\{\\s*\\.ds-table \\.ds-col-hide-${key}`));
+    expect(tokens).toContain(`--breakpoint-${key}: ${width}px`);
+  }
+});
