+import { afterEach, describe, expect, it, vi } from "vitest";
+import React from "react";
+import { act, render, screen, within } from "@testing-library/react";
+import { renderToString } from "react-dom/server";
+import { hydrateRoot } from "react-dom/client";
+import { DataTable } from "@/components/ds/DataTable";
+
+function viewport(initialWidth) {
+  let width = initialWidth;
+  const listeners = new Set();
+  vi.stubGlobal("matchMedia", (query) => ({
+    get matches() { return width < Number(query.match(/\d+/)[0]); },
+    addEventListener(_event, cb) { listeners.add(cb); },
+    removeEventListener(_event, cb) { listeners.delete(cb); },
+  }));
+  return (next) => act(() => { width = next; for (const cb of listeners) cb(); });
+}
+afterEach(() => vi.unstubAllGlobals());
+const rows = [{ id: 1, name: "A", value: 3 }, { id: 2, name: "B", value: 5 }];
+function columns(hiddenRender) { return [{ key: "name", header: "Player" }, { key: "value", header: "Value", numeric: true, sortable: true, hideBelow: "md", render: hiddenRender }]; }
+
+describe("opt-in hidden cell content", () => {
+  it("skips hidden children for newly published rows, preserves cells, and restores every value on resize", () => {
+    const resize = viewport(390);
+    const child = vi.fn((row) => <span>{row.value}</span>);
+    const props = { columns: columns(child), caption: "board", deferHiddenCellContent: true };
+    const view = render(<DataTable {...props} rows={[]} />);
+    view.rerender(<DataTable {...props} rows={rows} />);
+    expect(child).not.toHaveBeenCalled();
+    expect(screen.getAllByRole("cell")).toHaveLength(4);
+    expect(screen.getAllByRole("columnheader")).toHaveLength(2);
+    resize(768);
+    expect(screen.getAllByRole("cell").map((cell) => cell.textContent)).toEqual(["A", "3", "B", "5"]);
+    resize(767.5);
+    expect(screen.getAllByRole("cell").map((cell) => cell.textContent)).toEqual(["A", "", "B", ""]);
+  });
+  it("keeps opt-out tables unchanged and sorts the canonical hidden values", () => {
+    viewport(390);
+    const child = vi.fn((row) => row.value);
+    const view = render(<DataTable caption="board" rows={rows} columns={columns(child)} />);
+    expect(child).toHaveBeenCalledTimes(2);
+    view.rerender(<DataTable caption="board" rows={rows} columns={columns(child)} deferHiddenCellContent defaultSort={{ key: "value", direction: "desc" }} sort={{ key: "value", direction: "desc" }} />);
+    expect(screen.getAllByRole("row").slice(1).map((row) => within(row).getAllByRole("cell")[0].textContent)).toEqual(["B", "A"]);
+  });
+  it("hydrates preloaded rows consistently before applying the real media snapshot", async () => {
+    viewport(390);
+    const element = <DataTable caption="board" rows={rows} columns={columns((row) => row.value)} deferHiddenCellContent />;
+    const container = document.createElement("div");
+    container.innerHTML = renderToString(element);
+    expect(container.querySelector('[data-col="value"]').textContent).toBe("3");
+    const errors = [];
+    let root;
+    await act(async () => { root = hydrateRoot(container, element, { onRecoverableError: (error) => errors.push(error) }); });
+    expect(errors).toEqual([]);
+    expect([...container.querySelectorAll('[data-col="value"]')].map((cell) => cell.textContent)).toEqual(["", ""]);
+    await act(async () => root.unmount());
+  });
+});
